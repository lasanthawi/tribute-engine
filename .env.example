# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Marketing/growth automation
# Chat ID of a channel/group the bot is an admin of (auto-posts: digests, big wins, announcements)
OFFICIAL_CHANNEL_ID=
# Comma-separated Telegram user IDs allowed to run /stats, /broadcast, /announce
ADMIN_TELEGRAM_IDS=

# Mini App
MINI_APP_URL=https://your-app.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional — rate limiting / future job queue)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Oracles
PYTH_HERMES_URL=https://hermes.pyth.network
# Optional overrides for Pyth price feed IDs (defaults are mainnet BTC/ETH/TON feeds)
PYTH_FEED_BTC=
PYTH_FEED_ETH=
PYTH_FEED_TON=

# Cron auth — set this and configure Vercel cron jobs to send
# `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Game publisher agent (weekly cron — designs, tests, and publishes new
# mini-games). Both optional: without ANTHROPIC_API_KEY the cron skips the
# design step; without OPENAI_API_KEY cover art falls back to a procedural
# SVG (no Supabase Storage required).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sentiment widget (optional — CryptoPanic news headlines)
# If unset, the home screen shows only the Fear & Greed gauge (no headlines).
CRYPTOPANIC_API_KEY=
