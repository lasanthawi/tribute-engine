# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Mini App
MINI_APP_URL=https://your-app.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional — rate limiting / future job queue)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Oracles
PYTH_HERMES_URL=https://hermes.pyth.network
# Optional overrides for Pyth price feed IDs (defaults are mainnet BTC/ETH/TON feeds)
PYTH_FEED_BTC=
PYTH_FEED_ETH=
PYTH_FEED_TON=

# Cron auth — set this and configure Vercel cron jobs to send
# `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Sentiment widget (optional — CryptoPanic news headlines)
# If unset, the home screen shows only the Fear & Greed gauge (no headlines).
CRYPTOPANIC_API_KEY=
