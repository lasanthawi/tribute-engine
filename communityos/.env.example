# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=communityos-assets

# Telegram bot / Mini App
TELEGRAM_BOT_TOKEN=123456:replace-with-bot-token
TELEGRAM_BOT_USERNAME=communityos_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=communityos_bot
MINI_APP_URL=https://your-communityos-domain.vercel.app
TELEGRAM_WEBHOOK_URL=https://your-communityos-domain.vercel.app
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret

# Cron/API protection
CRON_SECRET=replace-with-long-random-secret

# Platform admin setup
# First-admin bootstrap: comma-separated Telegram numeric IDs. Anyone in this list is
# treated as a platform admin on login and auto-seeded into the platform_admins table,
# so the env var is only needed until the first admin exists. After that, manage admins
# from the Admins tab in /admin (opened inside Telegram).
ADMIN_TELEGRAM_IDS=123456789
