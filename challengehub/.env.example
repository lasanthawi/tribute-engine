# Telegram (new bot, separate from VoteLeague)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Comma-separated Telegram user IDs allowed to run /stats, /broadcast
ADMIN_TELEGRAM_IDS=

# Mini App
MINI_APP_URL=https://challengehub.vercel.app

# Supabase — SAME project/credentials as VoteLeague (shared identity/referral tables)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron auth — set this and configure Vercel cron jobs to send
# `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
